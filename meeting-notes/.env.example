# Anthropic API key for translation and minutes generation.
# Leave empty to run transcription-only (STT still works fully offline).
ANTHROPIC_API_KEY=

# Model used for translation and minutes generation.
ANTHROPIC_MODEL=claude-sonnet-5

# Cheaper/faster model for the translation queue specifically.
# Leave empty to reuse ANTHROPIC_MODEL.
ANTHROPIC_TRANSLATE_MODEL=

# Set to 1 to guarantee no text ever leaves this machine (disables
# translation and minutes generation; transcription is unaffected).
LOCAL_ONLY=0

# Whisper model selection.
WHISPER_MODEL_FINAL=large-v3-turbo
WHISPER_MODEL_PARTIAL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Server.
HOST=127.0.0.1
PORT=8420
